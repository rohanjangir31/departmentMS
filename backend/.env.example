# ============================================================
# AcademiQ Backend — Local Development Environment
# ============================================================
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
# ============================================================

# Server
PORT=4000
NODE_ENV=development

# MongoDB — use Docker Compose service name when running via docker compose
# For manual local dev, use MongoDB Atlas URI or a local MongoDB instance
MONGODB_URI=mongodb://localhost:27017/academiq

# JWT — change this to a long random string in production!
JWT_SECRET=academiq_dev_secret_change_me_in_production_2026

# CORS — frontend origin
FRONTEND_URL=http://localhost:3000
